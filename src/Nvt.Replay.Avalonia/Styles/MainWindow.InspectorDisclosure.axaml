<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Expander.inspectorDisclosure">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
      <Setter Property="Stroke" Value="{DynamicResource NfcTextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Expander.inspectorDisclosure /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.healthTextAlarm">
      <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
    </Style>
    <Style Selector="TextBlock.healthTextNormal">
      <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
    </Style>
    <Style Selector="GridSplitter.inspectorSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.inspectorSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcAccentBorderBrush}" />
    </Style>
</Styles>
