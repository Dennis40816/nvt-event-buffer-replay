<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.inspectorMetric">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.healthGood">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
    </Style>
    <Style Selector="Border.healthAlarm">
      <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerTextBrush}" />
    </Style>
    <Style Selector="ListBox.inspectorContacts ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.inspectorContacts ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.inspectorContacts ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.inspectorContacts ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.inspectorSectionTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    </Style>
</Styles>
