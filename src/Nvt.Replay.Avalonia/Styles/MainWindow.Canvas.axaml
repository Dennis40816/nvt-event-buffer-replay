<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.canvasSettingsPanel">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ComboBox.canvasControl">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.canvasControl:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.canvasField">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.paintSettingsBar">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ComboBox.semanticSelect">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="Padding" Value="11,0,8,0" />
    </Style>
    <Style Selector="ComboBox.semanticSelect:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.canvasSemanticSelect">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="31,0,7,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.canvasSemanticSelect /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBox.canvasSemanticSelect:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</Styles>
