<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="32,0,32,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    </Style>
    <Style Selector="TabControl.inspectorDetails TabItem">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="14,0,14,3" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="{DynamicResource NfcBorderSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.captureSetupBadge.detected">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
    </Style>
    <Style Selector="Border.captureSetupBadge.detected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}" />
    </Style>
    <Style Selector="Border.captureSetupBadge.review">
      <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningTextBrush}" />
    </Style>
    <Style Selector="Border.captureSetupBadge.review TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}" />
    </Style>
    <Style Selector="Border.captureSetupBadge.none">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    </Style>
    <Style Selector="Border.captureSetupBadge.none TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.captureSetupValidation.ready">
      <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.monoValue">
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
