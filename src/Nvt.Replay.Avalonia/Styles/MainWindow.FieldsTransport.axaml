<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ComboBox.headerInlineSelect">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBox.headerInlineInput">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.panelSize">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Width" Value="76" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.registerSearch">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.outputPreviewTransport">
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource NfcAppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="10,0,8,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcTextSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="{DynamicResource NfcControlHeight}" />
      <Setter Property="Margin" Value="3,1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
    </Style>
</Styles>
