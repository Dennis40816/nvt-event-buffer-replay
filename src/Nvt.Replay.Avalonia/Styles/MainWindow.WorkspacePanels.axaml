<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.canvasQuickBar">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.liveSettingGroup">
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.liveSettingGroup TextBlock.liveSettingLabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.paintMarkerRow">
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="Border.rawRecordRow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.rawRecordRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    </Style>
    <Style Selector="Border.rawRecordDetails">
      <Setter Property="Padding" Value="20,16,18,18" />
      <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ListBox.paintMarkerList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.paintMarkerList ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.paintMarkerList ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.paintMarkerList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</Styles>
