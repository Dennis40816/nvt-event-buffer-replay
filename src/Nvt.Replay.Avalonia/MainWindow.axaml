<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nvt.Replay.Avalonia.ViewModels"
        xmlns:controls="using:Nvt.Replay.Avalonia.Controls"
        x:Class="Nvt.Replay.Avalonia.MainWindow"
        Title="NVT Event Buffer Replay"
        Width="1480"
        Height="920"
        MinWidth="1040"
        MinHeight="700"
        Background="{DynamicResource WindowBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="LetterSpacing" Value="1.15" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed">
      <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.canvasIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.canvasIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.panelSize">
      <Setter Property="Height" Value="32" />
      <Setter Property="Width" Value="76" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="10,0,8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="3,1" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.axisToggle">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.axisToggle:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.axisToggle:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.axisToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="52,48,*,124">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0" ColumnDefinitions="Auto,18,*,Auto,6,Auto,6,Auto,6,Auto,6,Auto,8,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Border Width="6" Height="24" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
          <StackPanel Spacing="0">
            <TextBlock Text="NVT EVENT BUFFER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="REPLAY" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.6" Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="CaptureNameText" Text="NO CAPTURE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock x:Name="SessionStatusText" Text="Load a capture to begin" MaxWidth="390" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="SaveReviewButton" Grid.Column="3" Classes="ghost" Content="Save" IsEnabled="False" Click="SaveReviewButton_OnClick" AutomationProperties.Name="Save review" />
        <Button x:Name="LoadReviewButton" Grid.Column="5" Classes="ghost" Content="Review" IsEnabled="False" Click="LoadReviewButton_OnClick" AutomationProperties.Name="Open review" />
        <Button x:Name="ApplySidecarButton" Grid.Column="5" Classes="primary" Content="Apply mismatch" IsVisible="False" Click="ApplySidecarButton_OnClick" />
        <Button x:Name="ExportAnalysisButton" Grid.Column="7" Classes="ghost" Content="Export" IsEnabled="False" Click="ExportAnalysisButton_OnClick" AutomationProperties.Name="Export analysis" />
        <Button Grid.Column="9" Classes="ghost" Content="Commands" Click="CommandPaletteButton_OnClick" AutomationProperties.Name="Open command palette, Ctrl K" />
        <Button x:Name="ThemeButton" Grid.Column="11" Classes="ghost" Content="Dark" Click="ThemeButton_OnClick" AutomationProperties.Name="Change color theme" />
        <Button x:Name="CancelButton" Grid.Column="13" Classes="ghost" Content="Cancel" IsVisible="False" Click="CancelButton_OnClick" AutomationProperties.Name="Cancel current operation" />
        <Button x:Name="LoadButton" Grid.Column="13" Classes="primary" Content="Load capture" Click="LoadButton_OnClick" AutomationProperties.Name="Load capture file" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0" ColumnDefinitions="Auto,10,220,20,Auto,10,104,8,120,8,Auto,14,*,160">
        <TextBlock Grid.Column="0" Classes="section" Text="SOURCE" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="SourceAdapterText" Text="Not selected" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="SourceAdapterComboBox" IsVisible="False" PlaceholderText="Choose source adapter" SelectionChanged="SourceAdapterComboBox_OnSelectionChanged" />
          <TextBlock x:Name="SourceConfidenceText" Text="Source detection is advisory" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="3" Width="1" Height="24" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="section" Text="FORMAT" VerticalAlignment="Center" />
        <ComboBox x:Name="EventVersionComboBox" Grid.Column="6" PlaceholderText="Required" IsEnabled="False" SelectionChanged="EventVersionComboBox_OnSelectionChanged" DropDownClosed="EventVersionComboBox_OnDropDownClosed" AutomationProperties.Name="Event Buffer Version">
          <ComboBoxItem Content="0x82" />
          <ComboBoxItem Content="0x83" />
          <ComboBoxItem Content="0x84" />
          <ComboBoxItem Content="0x85" />
          <ComboBoxItem Content="0x97" />
        </ComboBox>
        <ComboBox x:Name="Desay97ProfileComboBox" Grid.Column="8" PlaceholderText="Palm profile" IsVisible="False" SelectedIndex="-1" SelectionChanged="Desay97ProfileComboBox_OnSelectionChanged" DropDownClosed="Desay97ProfileComboBox_OnDropDownClosed">
          <ComboBoxItem Content="Standard" />
          <ComboBoxItem Content="Benz Palm" />
        </ComboBox>
        <Button x:Name="DecodeButton" Grid.Column="10" Classes="primary" Content="Re-decode" IsEnabled="False" IsVisible="False" Click="DecodeButton_OnClick" AutomationProperties.Name="Decode capture" />
        <TextBlock x:Name="ConfigurationHintText" Grid.Column="12" Text="Raw Explorer opens before semantic configuration." FontSize="9" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar x:Name="LoadingProgress" Grid.Column="13" Height="3" IsIndeterminate="True" IsVisible="False" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceShellGrid" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="312" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="46,*">
          <Grid Grid.Row="0" Margin="12,0,8,0" ColumnDefinitions="*,Auto,6,Auto">
            <TextBlock x:Name="ReviewRailTitle" Classes="section" Text="REVIEW QUEUE" VerticalAlignment="Center" />
            <Border x:Name="ReviewRailCountBadge" Grid.Column="1" Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
              <TextBlock x:Name="DiagnosticCountText" Text="0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>
            <Button x:Name="ReviewRailToggleButton" Grid.Column="3" Classes="canvasIcon" Content="‹" Click="ReviewRailToggleButton_OnClick" AutomationProperties.Name="Collapse review queue" />
          </Grid>
          <Grid x:Name="ReviewRailContent" Grid.Row="1" Margin="12,4,12,12" RowDefinitions="Auto,10,*">
          <StackPanel Grid.Row="0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="ghost" Content="All" Tag="All" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="Warn" Tag="Warnings" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="Alarm" Tag="Alarms" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="ASIL" Tag="Asil" Click="ReviewFilterButton_OnClick" />
            </StackPanel>
            <CheckBox x:Name="PauseOnAlarmCheckBox" Content="Pause replay on Alarm / QA Fail" IsChecked="True" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" IsCheckedChanged="PauseOnAlarmCheckBox_OnIsCheckedChanged" />
          </StackPanel>
          <ListBox x:Name="DiagnosticListBox" Grid.Row="2" SelectionChanged="DiagnosticListBox_OnSelectionChanged" AutomationProperties.Name="Review queue findings">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewGroupRow">
                <Border BorderBrush="#242C31" BorderThickness="0,0,0,1" Padding="8,10">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="SemiBold" Foreground="#C9D0D2" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Severity}" FontSize="9" Foreground="#D8AD62" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" FontSize="10" Foreground="#707B81" TextWrapping="Wrap" MaxHeight="44" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Count}" FontSize="9" Foreground="#657078" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="9" FontWeight="SemiBold" Foreground="#9FB6BE" />
                    </Grid>
                    <TextBlock Text="{Binding Disposition}" FontSize="9" Foreground="#C8F36C" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource WorkspaceBrush}">
        <TabControl x:Name="WorkspaceTabs" Margin="18,10,18,14">
          <TabItem Header="RAW EXPLORER">
            <Grid RowDefinitions="34,*">
              <Grid Grid.Row="0" ColumnDefinitions="64,100,74,90,92,92,*" Margin="10,0">
                <TextBlock Classes="section" Text="INDEX" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="section" Text="PC TIME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="section" Text="OP" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="section" Text="TARGET" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="section" Text="ADDRESS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="section" Text="BYTES" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="section" Text="PAYLOAD PREVIEW" VerticalAlignment="Center" />
              </Grid>
              <ListBox x:Name="RawRecordsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="RawRecordsList_OnSelectionChanged" AutomationProperties.Name="Physical source records">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RawRecordRow">
                    <Border BorderBrush="#20272B" BorderThickness="0,0,0,1" Padding="10,8">
                      <Grid ColumnDefinitions="64,100,74,90,92,92,*">
                        <TextBlock Text="{Binding Index}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="2" Text="{Binding Operation}" FontSize="10" Foreground="#C8F36C" />
                        <TextBlock Grid.Column="3" Text="{Binding Target}" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="4" Text="{Binding Address}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C8CED0" />
                        <TextBlock Grid.Column="5" Text="{Binding ByteCount}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="6" Text="{Binding Preview}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#68747A" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="DECODED EVENTS">
            <Grid RowDefinitions="34,*">
              <Grid Grid.Row="0" ColumnDefinitions="70,110,90,90,100,*" Margin="10,0">
                <TextBlock Classes="section" Text="FRAME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="section" Text="PC TIME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="section" Text="TOUCHES" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="section" Text="CRC" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="section" Text="STATE" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="section" Text="SOURCE" VerticalAlignment="Center" />
              </Grid>
              <ListBox x:Name="DecodedFramesList" Grid.Row="1" SelectionChanged="DecodedFramesList_OnSelectionChanged" AutomationProperties.Name="Decoded logical frames">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecodedFrameRow">
                    <Border BorderBrush="#20272B" BorderThickness="0,0,0,1" Padding="10,8">
                      <Grid ColumnDefinitions="70,110,90,90,100,*">
                        <TextBlock Text="{Binding Index}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="2" Text="{Binding Touches}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#D2D8D6" />
                        <TextBlock Grid.Column="3" Text="{Binding Crc}" FontSize="10" Foreground="#C8F36C" />
                        <TextBlock Grid.Column="4" Text="{Binding State}" FontSize="10" Foreground="#D8AD62" />
                        <TextBlock Grid.Column="5" Text="{Binding SourceId}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#68747A" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem x:Name="PaintTab" Header="PAINT" IsEnabled="False">
            <Grid RowDefinitions="58,*">
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0" ColumnDefinitions="Auto,6,122,12,Auto,6,64,12,Auto,6,64,14,64,12,Auto,6,Auto,12,Auto,6,Auto,4,50,4,Auto,6,Auto,*">
                  <TextBlock Classes="section" Text="MODE" VerticalAlignment="Center" />
                  <ComboBox x:Name="PaintModeComboBox" Grid.Column="2" SelectedIndex="2" SelectionChanged="PaintModeComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="Host State" />
                    <ComboBoxItem Content="Reported Frame" />
                    <ComboBoxItem Content="Compare" />
                  </ComboBox>
                  <TextBlock Grid.Column="4" Classes="section" Text="TRAIL" VerticalAlignment="Center" />
                  <ComboBox x:Name="TrailLengthComboBox" Grid.Column="6" SelectedIndex="4" SelectionChanged="TrailLengthComboBox_OnSelectionChanged" AutomationProperties.Name="Trail point count">
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="4" Tag="4" />
                    <ComboBoxItem Content="6" Tag="6" />
                    <ComboBoxItem Content="8" Tag="8" />
                    <ComboBoxItem Content="10" Tag="10" />
                  </ComboBox>
                  <TextBlock Grid.Column="8" Classes="section" Text="PANEL" VerticalAlignment="Center" />
                  <TextBox x:Name="PanelWidthTextBox" Grid.Column="10" Classes="panelSize" Width="64" Text="2304" PlaceholderText="X" KeyDown="PanelResolutionTextBox_OnKeyDown" LostFocus="PanelResolutionTextBox_OnLostFocus" ToolTip.Tip="Panel X resolution. Press Enter to apply." AutomationProperties.Name="Panel width" />
                  <TextBlock Grid.Column="11" Text="×" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBox x:Name="PanelHeightTextBox" Grid.Column="12" Classes="panelSize" Width="64" Text="1280" PlaceholderText="Y" KeyDown="PanelResolutionTextBox_OnKeyDown" LostFocus="PanelResolutionTextBox_OnLostFocus" ToolTip.Tip="Panel Y resolution. Press Enter to apply." AutomationProperties.Name="Panel height" />
                  <Grid Grid.Column="14" Width="24" Height="24" VerticalAlignment="Center" ToolTip.Tip="ID color: ring is reported, core is host state, line is trail, cross is break.">
                    <Ellipse Width="20" Height="20" Stroke="#67D5E4" StrokeThickness="2.5" />
                    <Ellipse Width="9" Height="9" Fill="#67D5E4" Stroke="#090D0F" StrokeThickness="2" />
                  </Grid>
                  <Border Grid.Column="15" Width="1" Height="24" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                  <ToggleButton x:Name="ReverseXToggleButton" Grid.Column="16" Classes="axisToggle" MinWidth="64" Content="FLIP X" IsCheckedChanged="ReverseAxisToggleButton_OnIsCheckedChanged" AutomationProperties.Name="Reverse X axis" />
                  <ToggleButton x:Name="ReverseYToggleButton" Grid.Column="18" Classes="axisToggle" MinWidth="64" Content="FLIP Y" IsCheckedChanged="ReverseAxisToggleButton_OnIsCheckedChanged" AutomationProperties.Name="Reverse Y axis" />
                  <Border Grid.Column="19" Width="1" Height="24" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                  <Button Grid.Column="20" Classes="canvasIcon" Content="−" Click="PaintZoomOutButton_OnClick" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out" />
                  <Border Grid.Column="22" Width="50" Height="32" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="PaintZoomText" Text="100%" FontFamily="Cascadia Mono" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Button Grid.Column="24" Classes="canvasIcon" Content="+" Click="PaintZoomInButton_OnClick" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in" />
                  <Button Grid.Column="26" Classes="canvasIcon" Width="42" Content="FIT" FontSize="9" Click="PaintFitButton_OnClick" ToolTip.Tip="Fit panel to canvas" AutomationProperties.Name="Fit panel" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <controls:ReplayPaintSurface x:Name="PaintSurface" AutomationProperties.Name="Touch replay Paint surface" />
                </Border>
                <Border Margin="12" Padding="10,5" CornerRadius="4" Background="#E6171D21" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                  <TextBlock x:Name="PaintStatusText" MaxWidth="300" Text="Decode a Common capture to replay" FontFamily="Cascadia Mono" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem x:Name="AnalysisTab" Header="ANALYSIS" IsEnabled="False">
            <Grid Margin="16" RowDefinitions="Auto,18,*">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="REPRODUCIBLE ANALYSIS" Classes="section" />
                  <TextBlock Text="Transmission anomalies · ASIL lifecycle · Reported Frame hotspots" FontSize="12" Foreground="#B8C1C4" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Export replay" Click="ExportReplayButton_OnClick" />
                  <Button Classes="primary" Content="Export JSON / CSV / PNG" Click="ExportAnalysisButton_OnClick" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="2" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="22">
                <StackPanel Spacing="12">
                  <TextBlock x:Name="AnalysisSummaryText" Text="Decode a capture to generate analysis." FontSize="18" FontWeight="SemiBold" Foreground="#DDE3E1" TextWrapping="Wrap" />
                  <TextBlock Text="Outputs use the same selected replay range and decoder configuration as Paint. Invalid frames remain evidence and never contribute invented hotspot coordinates." FontSize="11" Foreground="#77848A" TextWrapping="Wrap" />
                  <TextBlock x:Name="AnalysisOutputText" Text="No output written" FontFamily="Cascadia Mono" FontSize="10" Foreground="#8E999E" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="46,*">
          <Grid Grid.Row="0" Margin="8,0,12,0" ColumnDefinitions="Auto,6,*">
            <Button x:Name="InspectorRailToggleButton" Classes="canvasIcon" Content="›" Click="InspectorRailToggleButton_OnClick" AutomationProperties.Name="Collapse inspector" />
            <TextBlock x:Name="InspectorRailTitle" Grid.Column="2" Classes="section" Text="INSPECTOR" VerticalAlignment="Center" />
          </Grid>
        <ScrollViewer x:Name="InspectorRailContent" Grid.Row="1">
          <StackPanel Margin="16,4,16,14" Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock x:Name="InspectorTitleText" Text="No record selected" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock x:Name="InspectorSubtitleText" Text="Select a physical record or decoded event." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ReviewActionsPanel" Spacing="7" IsVisible="False">
              <TextBlock Classes="section" Text="REVIEW EVENT" />
              <ComboBox x:Name="ReviewOccurrenceComboBox" PlaceholderText="Occurrence" SelectionChanged="ReviewOccurrenceComboBox_OnSelectionChanged" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Classes="ghost" Content="Acknowledge" Click="AcknowledgeReviewButton_OnClick" />
                <Button Classes="ghost" Content="Resolve" Click="ResolveReviewButton_OnClick" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Classes="ghost" Content="Expected" Tag="Expected" Click="DispositionReviewButton_OnClick" />
                <Button Classes="ghost" Content="False positive" Tag="FalsePositive" Click="DispositionReviewButton_OnClick" />
              </StackPanel>
              <StackPanel x:Name="AnnotationMetadataPanel" Spacing="5" IsVisible="False">
                <TextBox x:Name="MarkerQaCaseTextBox" PlaceholderText="QA case IDs (comma separated)" FontSize="10" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button Classes="ghost" Content="Apply QA refs" Click="ApplyMarkerQaButton_OnClick" />
                  <Button Classes="ghost" Content="Attach raw log" Click="AttachMarkerEvidenceButton_OnClick" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="ReviewStateText" FontFamily="Cascadia Mono" FontSize="9" Foreground="#8A969B" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="#2A3338" BorderThickness="0,1,0,1" Padding="0,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                <TextBlock Text="Source line" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="SourceLineText" Grid.Column="1" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C4CCCE" />
                <TextBlock Grid.Row="2" Text="Byte offset" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="SourceOffsetText" Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C4CCCE" />
                <TextBlock Grid.Row="4" Text="Stable ID" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="StableIdText" Grid.Row="4" Grid.Column="1" MaxWidth="210" Text="—" FontFamily="Cascadia Mono" FontSize="9" Foreground="#869197" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <TextBlock Classes="section" Text="TRANSPORT" />
            <TextBlock x:Name="TransportText" Text="No transport selected" FontFamily="Cascadia Mono" FontSize="10" Foreground="#A6B0B4" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="DECODED FIELDS" />
            <TextBlock x:Name="DecodedFieldsText" Text="Confirm Event Buffer Version to decode automatically." FontFamily="Cascadia Mono" FontSize="10" Foreground="#A6B0B4" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="RAW EVIDENCE" />
            <Border Background="#0E1214" BorderBrush="#293238" BorderThickness="1" Padding="12">
              <TextBlock x:Name="RawBytesText" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#8E999E" TextWrapping="Wrap" />
            </Border>

            <TextBlock Classes="section" Text="SOURCE IDENTITY" />
            <TextBlock x:Name="SourceHashText" Text="SHA-256 appears after loading" FontFamily="Cascadia Mono" FontSize="9" Foreground="#667279" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16,6" RowDefinitions="34,50,18">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,4,Auto,4,Auto,12,1,12,Auto,6,146,12,Auto,6,72,*,Auto,4,Auto,4,Auto,12,Auto,14,Auto">
          <Button x:Name="PreviousFrameButton" Classes="canvasIcon" Content="‹" IsEnabled="False" Click="PreviousFrameButton_OnClick" ToolTip.Tip="Previous frame" AutomationProperties.Name="Previous logical frame" />
          <Button x:Name="PlayPauseButton" Grid.Column="2" Classes="primary" MinWidth="76" Content="▶ PLAY" IsEnabled="False" Click="PlayPauseButton_OnClick" AutomationProperties.Name="Play or pause replay" />
          <Button x:Name="NextFrameButton" Grid.Column="4" Classes="canvasIcon" Content="›" IsEnabled="False" Click="NextFrameButton_OnClick" ToolTip.Tip="Next frame" AutomationProperties.Name="Next logical frame" />
          <Border Grid.Column="6" Width="1" Height="24" Background="{DynamicResource BorderBrush}" />
          <TextBlock Grid.Column="8" Classes="section" Text="CLOCK" VerticalAlignment="Center" />
          <ComboBox x:Name="ClockModeComboBox" Grid.Column="10" SelectedIndex="1" SelectionChanged="ClockModeComboBox_OnSelectionChanged" AutomationProperties.Name="Replay clock domain">
            <ComboBoxItem Content="Recorded" />
            <ComboBoxItem Content="TP Frame · 120 Hz" />
          </ComboBox>
          <TextBlock Grid.Column="12" Classes="section" Text="SPEED" VerticalAlignment="Center" />
          <ComboBox x:Name="ReplaySpeedComboBox" Grid.Column="14" Width="72" SelectedIndex="3" SelectionChanged="ReplaySpeedComboBox_OnSelectionChanged" AutomationProperties.Name="Replay speed">
            <ComboBoxItem Content="0.1×" Tag="0.1" />
            <ComboBoxItem Content="0.25×" Tag="0.25" />
            <ComboBoxItem Content="0.5×" Tag="0.5" />
            <ComboBoxItem Content="1×" Tag="1" />
            <ComboBoxItem Content="2×" Tag="2" />
            <ComboBoxItem Content="5×" Tag="5" />
            <ComboBoxItem Content="10×" Tag="10" />
            <ComboBoxItem Content="MAX" Tag="max" />
          </ComboBox>
          <Button x:Name="LoopInButton" Grid.Column="16" Classes="ghost" Content="Set in" IsEnabled="False" Click="LoopInButton_OnClick" />
          <Button x:Name="LoopOutButton" Grid.Column="18" Classes="ghost" Content="Set out" IsEnabled="False" Click="LoopOutButton_OnClick" />
          <Button x:Name="AddMarkerButton" Grid.Column="20" Classes="ghost" Content="Mark" IsEnabled="False" Click="AddMarkerButton_OnClick" />
          <CheckBox x:Name="CompressIdleCheckBox" Grid.Column="22" Content="Compress idle" IsChecked="True" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock x:Name="TimelineSummaryText" Grid.Column="24" Text="0 physical · 0 logical · 0 evidence" FontFamily="Cascadia Mono" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="14,22,14" ColumnDefinitions="74,*">
          <TextBlock Text="PHYSICAL" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
          <ProgressBar x:Name="PhysicalTimelineProgress" Grid.Column="1" Height="2" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource StrongBorderBrush}" />
          <TextBlock Grid.Row="1" Text="LOGICAL" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <ProgressBar x:Name="LogicalTimelineProgress" Grid.Row="1" Grid.Column="1" Height="3" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Grid.Row="2" Text="EVIDENCE" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
          <ProgressBar x:Name="EvidenceTimelineProgress" Grid.Row="2" Grid.Column="1" Height="2" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource WarningBrush}" />
          <Slider x:Name="ReplaySeekSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Opacity="0.9" ValueChanged="ReplaySeekSlider_OnValueChanged" AutomationProperties.Name="Replay position" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,12,Auto">
          <TextBlock x:Name="ReplayClockText" Text="00:00.000" FontFamily="Cascadia Mono" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" />
          <TextBlock x:Name="TimelineStatusText" Grid.Column="1" Text="Load a capture to index physical records" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
          <TextBlock x:Name="LoopRangeText" Grid.Column="2" Text="Loop —" FontFamily="Cascadia Mono" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" />
          <TextBlock x:Name="ReplayEndClockText" Grid.Column="4" Text="00:00.000" FontFamily="Cascadia Mono" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="CommandPaletteOverlay" Grid.RowSpan="4" IsVisible="False" Focusable="True" ZIndex="100" Background="#B0000000" KeyDown="CommandPaletteOverlay_OnKeyDown" AutomationProperties.Name="Command palette">
      <Border Width="520" MaxHeight="620" Padding="22" CornerRadius="10" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="COMMAND PALETTE" Classes="section" />
              <TextBlock Text="Replay actions and keyboard shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Esc" Click="CloseCommandPaletteButton_OnClick" AutomationProperties.Name="Close command palette" />
          </Grid>
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Load capture                                      Ctrl+O" Tag="load" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Decode selected format" Tag="decode" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Play / pause replay                              Space" Tag="play" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Previous / next frame                            ← / →" Tag="step" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Mark current frame                               M" Tag="mark" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Export analysis                                  Ctrl+E" Tag="analysis" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Export replay video" Tag="video" Click="CommandPaletteAction_OnClick" />
          <Button Classes="ghost" HorizontalContentAlignment="Left" Content="Toggle Dark / Light theme" Tag="theme" Click="CommandPaletteAction_OnClick" />
          <TextBlock Text="Home / End seek capture bounds · I / O set loop range" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
