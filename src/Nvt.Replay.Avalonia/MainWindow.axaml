<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nvt.Replay.Avalonia.ViewModels"
        xmlns:controls="using:Nvt.Replay.Avalonia.Controls"
        x:Class="Nvt.Replay.Avalonia.MainWindow"
        Title="NVT Event Buffer Replay"
        Width="1480"
        Height="920"
        MinWidth="1120"
        MinHeight="700"
        Background="#0F1215"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7D888E" />
      <Setter Property="LetterSpacing" Value="1.35" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#C8F36C" />
      <Setter Property="Foreground" Value="#111710" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C2CACD" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="56,54,*,154">
    <Border Grid.Row="0" Background="#15191D" BorderBrush="#2A3237" BorderThickness="0,0,0,1">
      <Grid Margin="18,0" ColumnDefinitions="Auto,24,*,Auto,8,Auto,8,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="NVT EVENT BUFFER" FontSize="15" FontWeight="Bold" Foreground="#F0F4F2" />
          <TextBlock Text="REPLAY WORKSTATION" FontSize="9" FontWeight="SemiBold" LetterSpacing="2.1" Foreground="#7E898F" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="26" Background="#30383E" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="CaptureNameText" Text="NO CAPTURE" FontSize="11" FontWeight="SemiBold" Foreground="#AEB7BB" />
          <TextBlock x:Name="SessionStatusText" Text="Load a capture to begin" FontSize="10" Foreground="#657078" />
        </StackPanel>
        <Button x:Name="SaveReviewButton" Grid.Column="3" Classes="ghost" Content="Save review" IsEnabled="False" Click="SaveReviewButton_OnClick" />
        <Button x:Name="LoadReviewButton" Grid.Column="5" Classes="ghost" Content="Open review" IsEnabled="False" Click="LoadReviewButton_OnClick" />
        <Button x:Name="ApplySidecarButton" Grid.Column="5" Classes="primary" Content="Apply mismatch" IsVisible="False" Click="ApplySidecarButton_OnClick" />
        <Button x:Name="CancelButton" Grid.Column="7" Classes="ghost" Content="Cancel" IsVisible="False" Click="CancelButton_OnClick" />
        <Button x:Name="LoadButton" Grid.Column="7" Classes="primary" Content="Load capture" Click="LoadButton_OnClick" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#121619" BorderBrush="#252D32" BorderThickness="0,0,0,1">
      <Grid Margin="18,0" ColumnDefinitions="Auto,12,260,28,Auto,12,112,8,126,8,Auto,*,180">
        <TextBlock Grid.Column="0" Classes="section" Text="SOURCE" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="SourceAdapterText" Text="Not selected" FontSize="11" Foreground="#D3D9D7" />
          <ComboBox x:Name="SourceAdapterComboBox" IsVisible="False" PlaceholderText="Choose source adapter" SelectionChanged="SourceAdapterComboBox_OnSelectionChanged" />
          <TextBlock x:Name="SourceConfidenceText" Text="Source detection is advisory" FontSize="9" Foreground="#657078" />
        </StackPanel>
        <Border Grid.Column="3" Width="1" Height="28" Background="#2B3338" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="section" Text="EVENT BUFFER VERSION" VerticalAlignment="Center" />
        <ComboBox x:Name="EventVersionComboBox" Grid.Column="6" PlaceholderText="Required" IsEnabled="False" SelectionChanged="EventVersionComboBox_OnSelectionChanged">
          <ComboBoxItem Content="0x82" />
          <ComboBoxItem Content="0x83" />
          <ComboBoxItem Content="0x84" />
          <ComboBoxItem Content="0x85" />
          <ComboBoxItem Content="0x97" />
        </ComboBox>
        <ComboBox x:Name="Desay97ProfileComboBox" Grid.Column="8" PlaceholderText="Palm profile" IsVisible="False" SelectedIndex="-1">
          <ComboBoxItem Content="Standard" />
          <ComboBoxItem Content="Benz Palm" />
        </ComboBox>
        <Button x:Name="DecodeButton" Grid.Column="10" Classes="primary" Content="Decode" IsEnabled="False" Click="DecodeButton_OnClick" />
        <TextBlock x:Name="ConfigurationHintText" Grid.Column="11" Margin="14,0" Text="Raw Explorer opens before semantic configuration." FontSize="10" Foreground="#657078" VerticalAlignment="Center" />
        <ProgressBar x:Name="LoadingProgress" Grid.Column="12" Height="3" IsIndeterminate="True" IsVisible="False" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="270,*,342">
      <Border Grid.Column="0" Background="#121619" BorderBrush="#293137" BorderThickness="0,0,1,0">
        <Grid Margin="16,16,14,14" RowDefinitions="Auto,12,Auto,10,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="REVIEW QUEUE" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#252D31" CornerRadius="9" Padding="7,2">
              <TextBlock x:Name="DiagnosticCountText" Text="0" FontSize="10" Foreground="#A8B1B5" />
            </Border>
          </Grid>
          <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="ghost" Content="All" Tag="All" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="Warn" Tag="Warnings" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="Alarm" Tag="Alarms" Click="ReviewFilterButton_OnClick" />
              <Button Classes="ghost" Content="ASIL" Tag="Asil" Click="ReviewFilterButton_OnClick" />
            </StackPanel>
            <CheckBox x:Name="PauseOnAlarmCheckBox" Content="Pause replay on Alarm / QA Fail" IsChecked="True" FontSize="10" Foreground="#8D989D" IsCheckedChanged="PauseOnAlarmCheckBox_OnIsCheckedChanged" />
          </StackPanel>
          <ListBox x:Name="DiagnosticListBox" Grid.Row="4" SelectionChanged="DiagnosticListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewGroupRow">
                <Border BorderBrush="#242C31" BorderThickness="0,0,0,1" Padding="8,10">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="SemiBold" Foreground="#C9D0D2" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Severity}" FontSize="9" Foreground="#D8AD62" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" FontSize="10" Foreground="#707B81" TextWrapping="Wrap" MaxHeight="44" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Count}" FontSize="9" Foreground="#657078" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="9" FontWeight="SemiBold" Foreground="#9FB6BE" />
                    </Grid>
                    <TextBlock Text="{Binding Disposition}" FontSize="9" Foreground="#C8F36C" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#0C0F11">
        <TabControl x:Name="WorkspaceTabs" Margin="18,10,18,14">
          <TabItem Header="RAW EXPLORER">
            <Grid RowDefinitions="34,*">
              <Grid Grid.Row="0" ColumnDefinitions="64,100,74,90,92,92,*" Margin="10,0">
                <TextBlock Classes="section" Text="INDEX" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="section" Text="PC TIME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="section" Text="OP" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="section" Text="TARGET" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="section" Text="ADDRESS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="section" Text="BYTES" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="section" Text="PAYLOAD PREVIEW" VerticalAlignment="Center" />
              </Grid>
              <ListBox x:Name="RawRecordsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="RawRecordsList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RawRecordRow">
                    <Border BorderBrush="#20272B" BorderThickness="0,0,0,1" Padding="10,8">
                      <Grid ColumnDefinitions="64,100,74,90,92,92,*">
                        <TextBlock Text="{Binding Index}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="2" Text="{Binding Operation}" FontSize="10" Foreground="#C8F36C" />
                        <TextBlock Grid.Column="3" Text="{Binding Target}" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="4" Text="{Binding Address}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C8CED0" />
                        <TextBlock Grid.Column="5" Text="{Binding ByteCount}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="6" Text="{Binding Preview}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#68747A" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="DECODED EVENTS">
            <Grid RowDefinitions="34,*">
              <Grid Grid.Row="0" ColumnDefinitions="70,110,90,90,100,*" Margin="10,0">
                <TextBlock Classes="section" Text="FRAME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="section" Text="PC TIME" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="section" Text="TOUCHES" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="section" Text="CRC" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="section" Text="STATE" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="section" Text="SOURCE" VerticalAlignment="Center" />
              </Grid>
              <ListBox x:Name="DecodedFramesList" Grid.Row="1" SelectionChanged="DecodedFramesList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecodedFrameRow">
                    <Border BorderBrush="#20272B" BorderThickness="0,0,0,1" Padding="10,8">
                      <Grid ColumnDefinitions="70,110,90,90,100,*">
                        <TextBlock Text="{Binding Index}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#9AA4A8" />
                        <TextBlock Grid.Column="2" Text="{Binding Touches}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#D2D8D6" />
                        <TextBlock Grid.Column="3" Text="{Binding Crc}" FontSize="10" Foreground="#C8F36C" />
                        <TextBlock Grid.Column="4" Text="{Binding State}" FontSize="10" Foreground="#D8AD62" />
                        <TextBlock Grid.Column="5" Text="{Binding SourceId}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#68747A" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem x:Name="PaintTab" Header="PAINT" IsEnabled="False">
            <Grid RowDefinitions="38,*">
              <Grid Margin="10,0" ColumnDefinitions="Auto,12,150,24,Auto,12,Auto,12,Auto,*">
                <TextBlock Classes="section" Text="VIEW" VerticalAlignment="Center" />
                <ComboBox x:Name="PaintModeComboBox" Grid.Column="2" SelectedIndex="2" SelectionChanged="PaintModeComboBox_OnSelectionChanged">
                  <ComboBoxItem Content="Host State" />
                  <ComboBoxItem Content="Reported Frame" />
                  <ComboBoxItem Content="Compare" />
                </ComboBox>
                <Ellipse Grid.Column="4" Width="9" Height="9" Fill="#C8F36C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="HOST" FontSize="9" Foreground="#78848A" VerticalAlignment="Center" />
                <Ellipse Grid.Column="7" Width="12" Height="12" Stroke="#58C7D9" StrokeThickness="2" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="REPORTED" FontSize="9" Foreground="#78848A" VerticalAlignment="Center" />
                <TextBlock x:Name="PaintStatusText" Grid.Column="9" Text="Decode a Common capture to replay" FontFamily="Cascadia Mono" FontSize="10" Foreground="#68747A" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="1" Background="#0A0D0F" BorderBrush="#20282D" BorderThickness="1">
                <controls:ReplayPaintSurface x:Name="PaintSurface" AutomationProperties.Name="Touch replay Paint surface" />
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <Border Grid.Column="2" Background="#14181B" BorderBrush="#293137" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Margin="18,16" Spacing="14">
            <TextBlock Classes="section" Text="INSPECTOR" />
            <StackPanel Spacing="4">
              <TextBlock x:Name="InspectorTitleText" Text="No record selected" FontSize="16" FontWeight="SemiBold" Foreground="#E0E5E3" />
              <TextBlock x:Name="InspectorSubtitleText" Text="Select a physical record or decoded event." FontSize="10" Foreground="#69757B" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ReviewActionsPanel" Spacing="7" IsVisible="False">
              <TextBlock Classes="section" Text="REVIEW EVENT" />
              <ComboBox x:Name="ReviewOccurrenceComboBox" PlaceholderText="Occurrence" SelectionChanged="ReviewOccurrenceComboBox_OnSelectionChanged" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Classes="ghost" Content="Acknowledge" Click="AcknowledgeReviewButton_OnClick" />
                <Button Classes="ghost" Content="Resolve" Click="ResolveReviewButton_OnClick" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Classes="ghost" Content="Expected" Tag="Expected" Click="DispositionReviewButton_OnClick" />
                <Button Classes="ghost" Content="False positive" Tag="FalsePositive" Click="DispositionReviewButton_OnClick" />
              </StackPanel>
              <StackPanel x:Name="AnnotationMetadataPanel" Spacing="5" IsVisible="False">
                <TextBox x:Name="MarkerQaCaseTextBox" PlaceholderText="QA case IDs (comma separated)" FontSize="10" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button Classes="ghost" Content="Apply QA refs" Click="ApplyMarkerQaButton_OnClick" />
                  <Button Classes="ghost" Content="Attach raw log" Click="AttachMarkerEvidenceButton_OnClick" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="ReviewStateText" FontFamily="Cascadia Mono" FontSize="9" Foreground="#8A969B" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="#2A3338" BorderThickness="0,1,0,1" Padding="0,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                <TextBlock Text="Source line" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="SourceLineText" Grid.Column="1" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C4CCCE" />
                <TextBlock Grid.Row="2" Text="Byte offset" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="SourceOffsetText" Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#C4CCCE" />
                <TextBlock Grid.Row="4" Text="Stable ID" FontSize="10" Foreground="#707C82" />
                <TextBlock x:Name="StableIdText" Grid.Row="4" Grid.Column="1" MaxWidth="210" Text="—" FontFamily="Cascadia Mono" FontSize="9" Foreground="#869197" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <TextBlock Classes="section" Text="TRANSPORT" />
            <TextBlock x:Name="TransportText" Text="No transport selected" FontFamily="Cascadia Mono" FontSize="10" Foreground="#A6B0B4" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="DECODED FIELDS" />
            <TextBlock x:Name="DecodedFieldsText" Text="Choose Event Buffer Version, then Decode." FontFamily="Cascadia Mono" FontSize="10" Foreground="#A6B0B4" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="RAW EVIDENCE" />
            <Border Background="#0E1214" BorderBrush="#293238" BorderThickness="1" Padding="12">
              <TextBlock x:Name="RawBytesText" Text="—" FontFamily="Cascadia Mono" FontSize="10" Foreground="#8E999E" TextWrapping="Wrap" />
            </Border>

            <TextBlock Classes="section" Text="SOURCE IDENTITY" />
            <TextBlock x:Name="SourceHashText" Text="SHA-256 appears after loading" FontFamily="Cascadia Mono" FontSize="9" Foreground="#667279" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#15191D" BorderBrush="#2A3237" BorderThickness="0,1,0,0">
      <Grid Margin="18,10" RowDefinitions="30,*,24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,6,Auto,6,Auto,18,Auto,6,120,12,Auto,6,Auto,6,Auto,12,Auto,6,Auto,*,Auto">
          <Button x:Name="PreviousFrameButton" Classes="ghost" Content="◀" IsEnabled="False" Click="PreviousFrameButton_OnClick" />
          <Button x:Name="PlayPauseButton" Grid.Column="2" Classes="primary" Content="▶ PLAY" IsEnabled="False" Click="PlayPauseButton_OnClick" />
          <Button x:Name="NextFrameButton" Grid.Column="4" Classes="ghost" Content="▶|" IsEnabled="False" Click="NextFrameButton_OnClick" />
          <TextBlock Grid.Column="6" Classes="section" Text="CLOCK" VerticalAlignment="Center" />
          <ComboBox x:Name="ClockModeComboBox" Grid.Column="8" SelectedIndex="0" SelectionChanged="ClockModeComboBox_OnSelectionChanged">
            <ComboBoxItem Content="Recorded" />
            <ComboBoxItem Content="Frame" />
          </ComboBox>
          <TextBlock Grid.Column="10" Classes="section" Text="SPEED" VerticalAlignment="Center" />
          <ComboBox x:Name="ReplaySpeedComboBox" Grid.Column="12" Width="72" SelectedIndex="3" SelectionChanged="ReplaySpeedComboBox_OnSelectionChanged">
            <ComboBoxItem Content="0.1×" Tag="0.1" />
            <ComboBoxItem Content="0.25×" Tag="0.25" />
            <ComboBoxItem Content="0.5×" Tag="0.5" />
            <ComboBoxItem Content="1×" Tag="1" />
            <ComboBoxItem Content="2×" Tag="2" />
            <ComboBoxItem Content="5×" Tag="5" />
            <ComboBoxItem Content="10×" Tag="10" />
            <ComboBoxItem Content="MAX" Tag="max" />
          </ComboBox>
          <Button x:Name="LoopInButton" Grid.Column="14" Classes="ghost" Content="IN" IsEnabled="False" Click="LoopInButton_OnClick" />
          <Button x:Name="LoopOutButton" Grid.Column="16" Classes="ghost" Content="OUT" IsEnabled="False" Click="LoopOutButton_OnClick" />
          <Button x:Name="AddMarkerButton" Grid.Column="18" Classes="ghost" Content="MARK" IsEnabled="False" Click="AddMarkerButton_OnClick" />
          <CheckBox x:Name="CompressIdleCheckBox" Grid.Column="19" Content="Compress idle" IsChecked="True" FontSize="10" Foreground="#7C878C" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock x:Name="TimelineSummaryText" Grid.Column="20" Text="0 physical · 0 logical · 0 evidence" FontFamily="Cascadia Mono" FontSize="10" Foreground="#737F85" VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,8" RowDefinitions="17,17,17" ColumnDefinitions="86,*">
          <TextBlock Text="PHYSICAL" FontSize="9" FontWeight="SemiBold" Foreground="#657078" VerticalAlignment="Center" />
          <ProgressBar x:Name="PhysicalTimelineProgress" Grid.Column="1" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="#101417" Foreground="#35434A" />
          <TextBlock Grid.Row="1" Text="LOGICAL" FontSize="9" FontWeight="SemiBold" Foreground="#657078" VerticalAlignment="Center" />
          <ProgressBar x:Name="LogicalTimelineProgress" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="#101417" Foreground="#C8F36C" />
          <TextBlock Grid.Row="2" Text="EVIDENCE" FontSize="9" FontWeight="SemiBold" Foreground="#657078" VerticalAlignment="Center" />
          <ProgressBar x:Name="EvidenceTimelineProgress" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0" ShowProgressText="False" Background="#101417" Foreground="#D8AD62" />
          <Slider x:Name="ReplaySeekSlider" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Opacity="0.72" ValueChanged="ReplaySeekSlider_OnValueChanged" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,12,Auto">
          <TextBlock x:Name="ReplayClockText" Text="00:00.000" FontFamily="Cascadia Mono" FontSize="9" Foreground="#AAB3B6" VerticalAlignment="Bottom" />
          <TextBlock x:Name="TimelineStatusText" Grid.Column="1" Text="Load a capture to index physical records" FontSize="9" Foreground="#59646B" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
          <TextBlock x:Name="LoopRangeText" Grid.Column="2" Text="Loop —" FontFamily="Cascadia Mono" FontSize="9" Foreground="#657078" VerticalAlignment="Bottom" />
          <TextBlock x:Name="ReplayEndClockText" Grid.Column="4" Text="00:00.000" FontFamily="Cascadia Mono" FontSize="9" Foreground="#59646B" VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
