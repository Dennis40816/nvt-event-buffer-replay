<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <GenerateDocumentationFile Condition="'$(HealthLayer)' == 'tests'">false</GenerateDocumentationFile>
    <GenerateDocumentationFile Condition="'$(HealthPublicApi)' == 'true'">true</GenerateDocumentationFile>

    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(HealthBaselineWarningIds)</WarningsNotAsErrors>

    <ErrorLog Condition="'$(HealthCollectDiagnostics)' == 'true'">$(RepoHealthRoot)artifacts/code-health/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />

    <AdditionalFiles Include="$(RepoHealthRoot)eng/core-health/BannedSymbols.Common.txt" />
    <AdditionalFiles Include="$(RepoHealthRoot)eng/core-health/BannedSymbols.Files.txt" />
    <AdditionalFiles Include="$(RepoHealthRoot)eng/code-health/$(HealthLayer)/BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(HealthLayer)' == 'tests'">
    <AdditionalFiles Include="$(RepoHealthRoot)eng/core-health/BannedSymbols.Tests.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(HealthPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <!-- The package adds both API files as AdditionalFiles when they exist. A second Include makes Roslyn warn
       about a duplicate source file when dotnet format loads the workspace. This target keeps a missing file an error. -->
  <Target Name="HealthRequirePublicApiFiles" BeforeTargets="CoreCompile" Condition="'$(HealthPublicApi)' == 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')"
           Text="HealthPublicApi requires PublicAPI.Shipped.txt next to the project file." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="HealthPublicApi requires PublicAPI.Unshipped.txt next to the project file." />
  </Target>
</Project>
